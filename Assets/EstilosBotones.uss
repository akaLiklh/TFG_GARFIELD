.boton {
    background-color: rgba(0, 0, 0, 0);
    background-image: url("project://database/Assets/Arte/UI/botones_menus.png?fileID=21300000&guid=21874e5dae59ad34985e42b7cd1b4dad&type=3#botones_menus");
    -unity-background-image-tint-color: rgb(200, 200, 200);
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 0;
    -unity-slice-top: 0;
    -unity-slice-bottom: 0;
    -unity-slice-right: 0;
    width: 280px;
    height: 50px;
    font-size: 24px;
    color: rgb(159, 159, 106);
    -unity-font-style: normal;
    margin-top: 10px;
    padding-bottom: 10px;
    border-width: 0;
    transition-duration: 0.15s;
    -unity-font: url("project://database/Assets/Arte/UI/Prince%20Valiant.ttf?fileID=12800000&guid=3df356ab79fc69844ac6cb83cdfdb6e9&type=3#Prince Valiant");
    -unity-font-definition: initial;
}

.boton:hover {
    color: rgb(240, 230, 180);
    -unity-background-image-tint-color: rgb(255, 255, 255);
    background-color: rgba(0, 0, 0, 0);
}

.boton:active {
    scale: 0.95 0.95;
    background-color: rgba(0, 0, 0, 0);
}
